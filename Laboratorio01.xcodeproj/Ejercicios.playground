// ===== 1.2 — Corregir errores =====
// ===== FIX: Este código tiene 4 errores. Encuéntralos y corrígelos
// Docente: Juan León

// FIX 1: 'let' define una constante que no puede cambiar su valor. Para reasignar se debe usar 'var'.
var puntaje = 50
puntaje = 80

// FIX 2: No se puede declarar dos veces una variable con 'var' en el mismo ámbito. Se usa solo el nombre para reasignar.
var nombre = "Ana"
nombre = "María"

// FIX 3: El valor 29.99 es decimal (Double) y se estaba tipando estrictamente como entero (Int).
let precio: Double = 29.99

// FIX 4: El valor "true" entre comillas es un texto (String), un booleano va sin comillas.
var activo: Bool = true


// ===== 1.3 — Predicciones =====
// ===== PREDICT: ¿Qué imprime cada línea? =====
// Docente: Juan León

let x = 10
var y = 20
y = y + x
print(y) // PREDICT 1: Imprime 30

let a = "Hola"
let b = "Mundo"
print(a + " " + b) // PREDICT 2: Imprime Hola Mundo

var contador = 0
contador = contador + 1
contador = contador + 1
contador = contador + 1
print(contador) // PREDICT 3: Imprime 3

let entero = 7
let decimal = Double(entero)
print(type(of: decimal)) // PREDICT 4: Imprime Double


