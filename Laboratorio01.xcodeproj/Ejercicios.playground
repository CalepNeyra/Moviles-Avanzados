print("\(v) x \(v) = \(v * v)")     // PREDICT 6b: 5 x 5 = 25
print("Hay \(v + 3) alumnos")       // PREDICT 6c: Hay 8 alumnos

let p1 = 100.0
let d = 0.15
print("Descuento: S/. \(p1 * d)") // PREDICT 6d: Descuento: S/. 15.0