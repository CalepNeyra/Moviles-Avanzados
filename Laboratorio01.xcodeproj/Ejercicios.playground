// ===== 2.3 — Corregir cálculos =====
// ===== FIX: Este código tiene 3 errores en los cálculos =====
// Docente: Juan León

// Se quiere calcular el promedio de 3 notas:
let nota1 = 15
let nota2 = 12
let nota3 = 18
// FIX 5: El resultado no es correcto por la precedencia de operadores (se dividía solo la nota3 antes de sumar). Se deben agrupar con paréntesis y castear a Double para obtener decimales reales.
let promedio = Double(nota1 + nota2 + nota3) / 3.0
print("Promedio: \(promedio)")

// Se quiere convertir Fahrenheit a Celsius:
let fahrenheit = 98.6
// FIX 6: Faltaban paréntesis para restar primero 32 a los grados Fahrenheit antes de multiplicar por 5 y dividir entre 9.
let celsius = (fahrenheit - 32.0) * 5.0 / 9.0
print("Celsius: \(celsius)")

// Se quiere obtener la división con decimales:
let dividendo = 25
let divisor = 7
// FIX 7: Al dividir dos Int da como resultado un Int (truncando decimales). Se debe convertir al menos uno a Double.
let resultado = Double(dividendo) / Double(divisor)
print("Resultado: \(resultado)")


// ===== 2.4 — Cálculos prácticos =====

// --- TODO 15: Calcula el IGV (18%) de un producto de S/. 350.00 ---
let precioProducto = 350.0
let igv = precioProducto * 0.18
let precioConIgv = precioProducto + igv
print("Precio: S/. \(precioProducto)")
print("IGV: S/. \(igv)")
print("Total: S/. \(precioConIgv)")

